# ==============================================================================
# BREAKPOINT CREATIVA - VARIABLES DE ENTORNO
# ==============================================================================
# Copie este archivo como .env.local para desarrollo o configure estas variables
# en su proveedor de hosting (por ejemplo Vercel, Railway, Coolify, etc.).
# ==============================================================================

# Secreto criptográfico para firma y encriptación de sesiones de Better Auth.
# Genere una cadena aleatoria de al menos 32 caracteres (ej: openssl rand -base64 32).
BETTER_AUTH_SECRET="cambiar_por_un_secreto_seguro_de_al_menos_32_caracteres"

# URL canónica base de la aplicación (usada para callbacks y cookies de sesión).
# En desarrollo: http://localhost:8080 o http://127.0.0.1:8080
# En producción: https://breakpointcreativa.com
BETTER_AUTH_URL="https://breakpointcreativa.com"

# URL de conexión a la base de datos PostgreSQL (producción).
# Si no está definida en desarrollo local, el sistema utiliza PGLite automáticamente.
DATABASE_URL="postgres://usuario:password@host:5432/nombre_base_datos"
